# Formulario de contacto (POST /api/contact) — envía con Resend (https://resend.com)
# Sin RESEND_API_KEY el formulario responde "no configurado" y ofrece el email directo.
RESEND_API_KEY=
# Bandeja que recibe los mensajes (por defecto hello@odincodex.com)
CONTACT_TO_EMAIL=
# Remitente verificado en Resend, p. ej. "OdinCodex <web@odincodex.com>"
CONTACT_FROM_EMAIL=

# Verificación de propiedad en buscadores (solo el valor del atributo content de la meta tag).
# Google Search Console → Propiedad de prefijo de URL → Etiqueta HTML.
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → Agregar sitio → Metaetiqueta HTML (msvalidate.01).
BING_SITE_VERIFICATION=

# Google Analytics 4: ID de medición "G-XXXXXXXXXX". Sin valor no se carga gtag.js.
NEXT_PUBLIC_GA_ID=
